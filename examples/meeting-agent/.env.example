# Copy to the repository root as `.env` and fill in your values.
# `.env` is git-ignored; never commit real keys.
# Existing environment variables win over values in this file.

# Custom provider API key (used by the meeting Gateway to run the model).
NBWCODE_API_KEY=

# Meeting materials service (the local mock Gateway itself).
MEETING_SERVICE_URL=http://127.0.0.1:4010

# Internal service token the materials tool uses; demo value for the mock.
MEETING_INTERNAL_TOKEN=demo-user-001

# Optional: override the Gateway listen port.
# PORT=4010

# Optional: fail a stuck agent run after this many milliseconds instead of
# leaving the UI polling forever. Default 600000 (10 minutes); first-token
# latency on the demo provider was observed between seconds and ~3 minutes.
# MEETING_RUN_TIMEOUT_MS=600000
